{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/${fileBasenameNoExtension}",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Current File"
        },
        {
            "name": "Debug (Native Debug / GDB)",
            "type": "gdb",
            "request": "launch",
            "target": "${workspaceFolder}/build/${fileBasenameNoExtension}",
            "cwd": "${workspaceFolder}",
            "valuesFormatting": "parseText",
            "preLaunchTask": "Build Current File"
        }
    ]
}
